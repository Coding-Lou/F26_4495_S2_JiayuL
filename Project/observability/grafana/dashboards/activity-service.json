{
  "uid": "outdoor-activity",
  "title": "Outdoor Trip | Activity Service",
  "tags": ["outdoor", "activity-service"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Activity service reachable",
      "description": "Prometheus scrape status; this is not an end-to-end booking check.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"activity-service\"}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Join responses / second",
      "description": "HTTP 201 = newly created; 200 = existing registration; 409 and 503 are distinct responses. Rates do not prove seat invariants.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"activity-service\",method=\"POST\",uri=\"/api/group-events/{eventId}/registrations\"}[1m]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Join latency P95",
      "description": "Server-side HTTP latency for the join endpoint, using the Micrometer histogram.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"activity-service\",method=\"POST\",uri=\"/api/group-events/{eventId}/registrations\"}[1m])))", "legendFormat": "P95"}],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Cancel responses / second",
      "description": "HTTP 204 includes both a new cancellation and a repeated cancellation in the current controller.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"activity-service\",method=\"DELETE\",uri=\"/api/group-events/{eventId}/registrations\"}[1m]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "JVM heap used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"activity-service\",area=\"heap\"})", "legendFormat": "heap"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "Registration pending / minute",
      "description": "Includes normal in-flight duplicate requests and persistent ghost admissions; volume alone cannot tell them apart.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(groupevent_registration_pending_total{job=\"activity-service\"}[5m])) * 60", "legendFormat": "pending / minute"}],
      "fieldConfig": {"defaults": {"unit": "none", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 23}
    },
    {
      "id": 7,
      "title": "Redis seat release failures (5m)",
      "description": "Any failed or no-op release can leave Redis out of sync with Postgres and requires investigation.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "outdoor-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(groupevent_redis_release_failed_total{job=\"activity-service\"}[5m]))", "legendFormat": "failures / 5m"}],
      "fieldConfig": {"defaults": {"unit": "none", "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 23}
    }
  ]
}

# Leave empty to use the frontend's current origin, or set a backend/proxy origin.
VITE_API_BASE_URL=

# Sign-in (Keycloak, public client, Authorization Code + PKCE).
# These three values identify the identity provider. They are not secrets:
# the client has no client secret, and nothing secret belongs in this file.
# Copy this file to .env.local for local development. The values below are
# the local ones (docker compose, realm "outdoor-trip", client "outdoor-web").
# The dev server must run on http://localhost:5173, the only origin the
# client accepts redirects for.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=outdoor-trip
VITE_KEYCLOAK_CLIENT_ID=outdoor-web

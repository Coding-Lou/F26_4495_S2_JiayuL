# Local Demo configuration. scripts/demo-up.sh copies this file to .env.demo
# (git-ignored) on first run; edit .env.demo, not this file.
# Every value here is a local placeholder, not a credential for anything real.

# Browser-facing ports. The demo realm's redirect URIs and the token issuer
# are derived from them; change them before the first start (or reset).
DEMO_WEB_PORT=3000
DEMO_KEYCLOAK_PORT=8181

# Demo database (inside the demo network only; no host port).
POSTGRES_USER=outdoor
POSTGRES_PASSWORD=outdoor-demo

# Keycloak admin console: http://localhost:8181/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-demo

# Demo accounts (imported into the demo realm on first start): demo, demo2.
# DEMO_USER_ID is demo's fixed account id, used to seed its Past Plans.
DEMO_USER_ID=0d3c2a9e-6f41-4b8a-9c2d-5e7f1a2b3c4d
DEMO_USER_PASSWORD=demo-password
DEMO_SEEDER_CLIENT_SECRET=demo-seeder-secret

# Memory photos are stored in a demo volume and served through signed links.
MEMORY_STORAGE_LOCAL_SIGNING_SECRET=local-demo-photo-signing-secret

# Planner intent extraction. Default: the local mock (no key, no network).
# For the real provider: OPENAI_API_KEY=<your key>, OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=local-mock-key
OPENAI_BASE_URL=http://external-mocks:8090/v1

# Weather. Default: the real Open-Meteo (free, no key; needs internet).
# Offline demo: WEATHER_BASE_URL=http://external-mocks:8090 (sample forecasts).
WEATHER_BASE_URL=https://api.open-meteo.com

# Tag for the locally built images (outdoor/<service>:<tag>).
IMAGE_TAG=local
